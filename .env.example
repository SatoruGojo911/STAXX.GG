# ============================================================
# STAXX.GG Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# ── Frontend ─────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ── Backend ──────────────────────────────────────────────────
ENVIRONMENT=development
FRONTEND_URL=http://localhost:3000
MONGODB_URI=mongodb://staxx:staxx_dev_password@localhost:27017/staxx?authSource=admin
MONGODB_DATABASE=staxx
REDIS_URL=redis://localhost:6379/0
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
SESSION_SECRET=change-this-to-a-random-64-char-string-in-production
COOKIE_DOMAIN=localhost

# ── Data Importer ────────────────────────────────────────────
POKEAPI_BASE_URL=https://pokeapi.co/api/v2
DATA_VERSION=1
